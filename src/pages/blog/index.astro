---
import Base from '../../layouts/Base.astro';
import { posts, TIPOS, extracto, fecha, urlPost, type TipoPost } from '../../lib/contenido';
import { certificaciones } from '../../data/certificaciones';
import { mismaCert } from '../../lib/contenido';

const todos = await posts();
const tipos = (Object.keys(TIPOS) as TipoPost[]).filter((t) => todos.some((p) => p.data.tipo === t));
const certDe = (p: (typeof todos)[number]) =>
  certificaciones.find((c) => mismaCert(c.id, p.data.certificacion) || mismaCert(c.nombre, p.data.certificacion));
---

<Base titulo="Blog | Alejandro Hervás" descripcion="Técnicas, investigaciones y apuntes de seguridad ofensiva, y cómo preparo cada certificación.">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
    <header class="max-w-3xl">
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-none tracking-[-0.03em] text-white">Blog</h1>
      <p class="mt-5 text-lg leading-relaxed text-tenue">
        Técnicas que voy descubriendo, investigaciones, apuntes de estudio y cómo preparo cada certificación.
      </p>
    </header>

    {todos.length > 0 && (
      <div class="mt-10 flex flex-col gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tipo">
          <button type="button" data-tipo="" aria-pressed="true" class="filtro">Todo</button>
          {tipos.map((t) => (
            <button type="button" data-tipo={t} aria-pressed="false" class="filtro">{TIPOS[t].varias}</button>
          ))}
        </div>
        <p id="filtro-cert" class="hidden text-tenue">
          Solo los apuntes de la <strong id="nombre-cert" class="text-texto"></strong>.
          <a href="/blog/" class="text-carmesi-claro underline decoration-1 underline-offset-4 hover:text-white">Ver todo</a>
        </p>
        <label class="sr-only" for="buscar">Buscar en el blog</label>
        <input
          id="buscar"
          type="search"
          placeholder="Busca por título, etiqueta o tema"
          class="h-11 max-w-xl rounded-lg border border-linea bg-superficie px-4 text-texto placeholder:text-tenue/70 focus:border-carmesi-claro focus:outline-none"
        />
      </div>
    )}

    {todos.length === 0 ? (
      <p class="mt-12 text-tenue">Todavía no hay nada publicado en el blog.</p>
    ) : (
      <ol class="mt-8 border-t border-linea" id="lista">
        {todos.map((p) => {
          const cert = certDe(p);
          return (
            <li
              class="group relative grid gap-x-8 gap-y-1 border-b border-linea py-5 sm:grid-cols-[8.5rem_1fr]"
              data-tipo={p.data.tipo}
              data-cert={cert?.id ?? ''}
              data-texto={[p.data.titulo, ...p.data.tags, extracto(p)].join(' ').toLowerCase()}
            >
              <div class="flex gap-3 text-sm text-tenue sm:flex-col sm:gap-0.5">
                <time datetime={p.data.fecha.toISOString()}>{fecha(p.data.fecha)}</time>
                <span>{TIPOS[p.data.tipo].una}{p.data.certificacion && <span class="sm:block"><span class="sm:hidden">, </span>{cert?.nombre ?? p.data.certificacion}</span>}</span>
              </div>
              <div>
                <h2 class="text-lg font-semibold leading-snug text-texto">
                  <a href={urlPost(p)} class="after:absolute after:inset-0 group-hover:text-carmesi-claro">{p.data.titulo}</a>
                  {p.data.borrador && <span class="ml-2 text-sm font-normal text-amber-300">(borrador)</span>}
                </h2>
                <p class="mt-1 max-w-[68ch] text-tenue">{extracto(p)}</p>
              </div>
            </li>
          );
        })}
      </ol>
    )}
    <p id="sin-resultados" class="mt-8 hidden text-tenue">Nada coincide con esa búsqueda.</p>
  </div>
</Base>

<script>
  import { certificaciones } from '../../data/certificaciones';

  const botones = [...document.querySelectorAll<HTMLButtonElement>('button[data-tipo]')];
  const buscar = document.querySelector<HTMLInputElement>('#buscar');
  const filas = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
  const sinResultados = document.querySelector('#sin-resultados');
  const parametros = new URLSearchParams(location.search);
  const cert = parametros.get('cert') ?? '';
  let tipo = parametros.get('tipo') ?? '';

  if (cert) {
    const c = certificaciones.find((c) => c.id === cert);
    document.querySelector('#nombre-cert')!.textContent = c?.nombre ?? cert.toUpperCase();
    document.querySelector('#filtro-cert')?.classList.remove('hidden');
  }

  function filtrar() {
    const texto = (buscar?.value ?? '').trim().toLowerCase();
    let visibles = 0;
    for (const f of filas) {
      const ok =
        (!tipo || f.dataset.tipo === tipo) &&
        (!cert || f.dataset.cert === cert) &&
        (!texto || (f.dataset.texto ?? '').includes(texto));
      f.hidden = !ok;
      if (ok) visibles++;
    }
    for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.tipo === tipo));
    sinResultados?.classList.toggle('hidden', visibles > 0 || filas.length === 0);
  }

  for (const b of botones) {
    b.addEventListener('click', () => {
      tipo = b.dataset.tipo ?? '';
      const url = new URL(location.href);
      if (tipo) url.searchParams.set('tipo', tipo);
      else url.searchParams.delete('tipo');
      history.replaceState(null, '', url);
      filtrar();
    });
  }
  buscar?.addEventListener('input', filtrar);
  filtrar();
</script>

<style>
  .filtro {
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    color: var(--color-tenue);
    cursor: pointer;
  }
  .filtro:hover {
    color: var(--color-texto);
    border-color: var(--color-tenue);
  }
  .filtro[aria-pressed='true'] {
    color: #fff;
    background-color: var(--color-carmesi);
    border-color: var(--color-carmesi);
  }
</style>
