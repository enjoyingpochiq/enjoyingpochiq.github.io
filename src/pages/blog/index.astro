---
// src/pages/blog/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Obtenemos todos los posts de la colección 'microblog'
const allPosts = await getCollection('microblog');

// 2. Ordenamos por fecha (del más reciente al más antiguo)
const sortedPosts = allPosts.sort((a, b) => {
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

// 3. Extraemos las categorías únicas de los posts para crear los filtros
const categories = ["Todas", ...new Set(sortedPosts.map(post => post.data.category))];
---

<Layout title="Micro-Blog | Alejandro Juan Hervás Vogt">
    <main class="max-w-5xl mx-auto pt-2 pb-24 px-6 md:px-0 animate-fade-in">
        
        <a href="/" class="inline-flex items-center gap-2 text-xl font-mono text-zinc-500 hover:text-red-accent transition-colors mb-12">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Volver al inicio
        </a>

        <header class="flex flex-col gap-6 mb-12 relative">
            <div class="absolute -top-10 -left-10 w-40 h-40 bg-red-accent/10 blur-[60px] rounded-full pointer-events-none -z-10"></div>
            <h3 class="text-3xl font-mono text-red-accent uppercase tracking-widest">Knowledge Base</h3>
            <h1 class="text-5xl md:text-6xl font-extrabold text-white tracking-tighter leading-tight">
                El registro de <br/>
                <span class="text-zinc-500">auditoría.</span>
            </h1>
            <p class="text-zinc-400 max-w-2xl text-2xl">
                Conceptos técnicos, opiniones y apuntes sobre materiales que estudio en mi día a día.
            </p>
        </header>

        <div class="flex flex-col gap-6 mb-12">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-zinc-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="Buscar artículos por título o palabra clave..." 
                    class="w-full bg-zinc-900/50 border border-zinc-800 text-white rounded-2xl py-4 pl-12 pr-4 focus:outline-none focus:border-red-accent/50 focus:ring-1 focus:ring-red-accent/50 transition-all font-mono text-sm placeholder:text-zinc-600"
                />
            </div>

            <div class="flex flex-wrap gap-2" id="categoryFilters">
                {categories.map((category) => (
                    <button 
                        class="filter-btn px-4 py-2 text-xs font-mono uppercase tracking-wider rounded-xl border transition-all duration-300
                               data-[active=true]:bg-red-accent/10 data-[active=true]:text-red-accent data-[active=true]:border-red-accent/30
                               data-[active=false]:bg-zinc-900 data-[active=false]:text-zinc-400 data-[active=false]:border-zinc-800 hover:data-[active=false]:border-zinc-600"
                        data-category={category}
                        data-active={category === "Todas" ? "true" : "false"}
                    >
                        {category}
                    </button>
                ))}
            </div>
        </div>

        <div class="flex flex-col gap-4" id="postsContainer">
            {sortedPosts.length === 0 ? (
                <p class="text-zinc-500 font-mono text-sm mt-8">No hay artículos publicados todavía.</p>
            ) : (
                sortedPosts.map((post, index) => (
                    // Fíjate en los data-title y data-category, los usamos para el buscador JS
                    <a href={`/blog/${post.id}`} 
                       class="post-card group relative flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 rounded-2xl bg-bg-card border border-border-subtle overflow-hidden transition-all duration-300 hover:border-red-accent/50 hover:bg-zinc-900/50"
                       data-title={post.data.title.toLowerCase()} 
                       data-category={post.data.category}
                       style={`animation: fadeUp 0.5s ease-out ${index * 0.1}s backwards;`}>
                       
                        <div class="absolute -left-10 top-1/2 -translate-y-1/2 w-20 h-20 bg-red-accent/10 blur-[40px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

                        <div class="relative z-10 flex flex-col gap-2">
                            <div class="flex items-center gap-3">
                                <span class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-red-accent bg-red-accent/10 rounded border border-red-accent/20">
                                    {post.data.category}
                                </span>
                                <span class="text-xs font-mono text-zinc-500">{post.data.date}</span>
                            </div>
                            <h4 class="text-xl md:text-2xl font-bold text-zinc-200 group-hover:text-white transition-colors tracking-tight">
                                {post.data.title}
                            </h4>
                        </div>

                        <div class="relative z-10 flex items-center gap-4 mt-2 md:mt-0">
                            <span class="text-xs font-mono text-zinc-500 hidden md:block">{post.data.readTime} read</span>
                            <div class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-500 group-hover:text-white group-hover:bg-red-accent group-hover:border-red-accent transition-all duration-300 shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
                            </div>
                        </div>
                    </a>
                ))
            )}
            
            <div id="noResults" class="hidden p-8 text-center border border-dashed border-zinc-800 rounded-2xl mt-4">
                <p class="text-zinc-500 font-mono text-sm">No se encontraron artículos que coincidan con la búsqueda.</p>
            </div>
        </div>

    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput') as HTMLInputElement;
        const filterBtns = document.querySelectorAll('.filter-btn');
        const postCards = document.querySelectorAll('.post-card');
        const noResults = document.getElementById('noResults');
        
        let currentCategory = 'Todas';
        let searchQuery = '';

        // Función para filtrar los posts
        const filterPosts = () => {
            let visibleCount = 0;

            postCards.forEach((card) => {
                const title = card.getAttribute('data-title') || '';
                const category = card.getAttribute('data-category') || '';
                
                const matchesSearch = title.includes(searchQuery);
                const matchesCategory = currentCategory === 'Todas' || category === currentCategory;

                if (matchesSearch && matchesCategory) {
                    (card as HTMLElement).style.display = 'flex';
                    visibleCount++;
                } else {
                    (card as HTMLElement).style.display = 'none';
                }
            });

            // Mostrar mensaje si no hay resultados
            if (noResults) {
                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            }
        };

        // Escuchar el input del buscador
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
                filterPosts();
            });
        }

        // Escuchar clicks en los botones de categoría
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Actualizar estado visual de los botones
                filterBtns.forEach(b => b.setAttribute('data-active', 'false'));
                btn.setAttribute('data-active', 'true');
                
                // Aplicar el filtro
                currentCategory = btn.getAttribute('data-category') || 'Todas';
                filterPosts();
            });
        });
    });
</script>

<style>
    /* Animación simple en CSS para la carga inicial de los posts */
    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>