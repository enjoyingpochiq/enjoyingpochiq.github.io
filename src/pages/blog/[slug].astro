---
import { render } from 'astro:content';
import Lectura from '../../layouts/Lectura.astro';
import { posts, TIPOS, minutos, extracto } from '../../lib/contenido';
import { certificaciones } from '../../data/certificaciones';
import { mismaCert } from '../../lib/contenido';

export async function getStaticPaths() {
  return (await posts()).map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content, headings } = await render(p);
const cert = p.data.certificacion
  ? certificaciones.find((c) => mismaCert(c.id, p.data.certificacion) || mismaCert(c.nombre, p.data.certificacion))
  : undefined;
---

<Lectura
  titulo={p.data.titulo}
  tituloPagina={p.data.titulo}
  descripcion={extracto(p)}
  miga={{ texto: 'Blog', href: '/blog/' }}
  fecha={p.data.fecha}
  minutos={minutos(p.body)}
  etiquetas={p.data.tags}
  headings={headings}
  borrador={p.data.borrador}
>
  <Fragment slot="meta">
    <a href={`/blog/?tipo=${p.data.tipo}`} class="text-texto underline decoration-carmesi decoration-2 underline-offset-4 hover:text-white">
      {TIPOS[p.data.tipo].una}
    </a>
    {p.data.certificacion && (
      cert ? (
        <a href={`/blog/?cert=${cert.id}`} class="hover:text-texto">Para la {cert.nombre}</a>
      ) : (
        <span>Para la {p.data.certificacion}</span>
      )
    )}
  </Fragment>
  <Content />
</Lectura>
