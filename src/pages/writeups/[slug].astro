---
import { render } from 'astro:content';
import Lectura from '../../layouts/Lectura.astro';
import Icono from '../../components/Icono.astro';
import Cadena from '../../components/Cadena.astro';
import { writeups, DIFICULTADES, minutos, extracto, cadena } from '../../lib/contenido';

export async function getStaticPaths() {
  return (await writeups()).map((w) => ({ params: { slug: w.id }, props: { w } }));
}

const { w } = Astro.props;
const { Content, headings } = await render(w);
const dificultad = DIFICULTADES[w.data.dificultad];
const windows = w.data.so.toLowerCase().includes('windows');
---

<Lectura
  titulo={w.data.maquina}
  tituloPagina={`${w.data.maquina}, write-up de ${w.data.plataforma}`}
  descripcion={extracto(w)}
  miga={{ texto: 'Write-ups', href: '/writeups/' }}
  fecha={w.data.fecha}
  minutos={minutos(w.body)}
  etiquetas={w.data.tags}
  headings={headings}
  borrador={w.data.borrador}
  imagen={`/og/writeups/${w.id}.png`}
>
  <Fragment slot="meta">
    <span>{w.data.plataforma}</span>
    <span class="inline-flex items-center gap-1.5"><Icono nombre={windows ? 'windows' : 'linux'} tam={15} />{w.data.so}</span>
    <span class={`rounded-md border px-2 py-0.5 text-sm font-semibold ${dificultad.clase}`}>{dificultad.nombre}</span>
  </Fragment>
  {w.data.cadena.length > 0 && <Cadena slot="cabecera" pasos={cadena(w)} />}
  <Content />
</Lectura>
