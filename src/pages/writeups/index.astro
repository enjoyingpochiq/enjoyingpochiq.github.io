---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { writeups, DIFICULTADES, extracto, fecha, urlWriteup } from '../../lib/contenido';

const todos = await writeups();
const plataformas = [...new Set(todos.map((w) => w.data.plataforma))].sort();
const sistemas = [...new Set(todos.map((w) => w.data.so))].sort();
const dificultades = (Object.keys(DIFICULTADES) as (keyof typeof DIFICULTADES)[]).filter((d) =>
  todos.some((w) => w.data.dificultad === d),
);
const conFiltros = todos.length > 3;
---

<Base titulo="Write-ups | Alejandro Hervás" descripcion="Write-ups de máquinas retiradas de HackTheBox y otras plataformas: reconocimiento, explotación y escalada de privilegios.">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 sm:pt-20">
    <header class="max-w-3xl">
      <h1 class="text-[clamp(2.5rem,6vw,4rem)] font-extrabold leading-none tracking-[-0.03em] text-white">Write-ups</h1>
      <p class="mt-5 text-lg leading-relaxed text-tenue">
        Máquinas retiradas, de principio a fin: reconocimiento, enumeración, explotación y escalada de privilegios.
      </p>
    </header>

    {conFiltros && (
      <div class="mt-10 grid gap-3 sm:grid-cols-[1fr_auto_auto_auto]" role="search">
        <label class="sr-only" for="buscar">Buscar</label>
        <input
          id="buscar"
          type="search"
          placeholder="Busca una máquina o una técnica, por ejemplo DCSync"
          class="h-11 rounded-lg border border-linea bg-superficie px-4 text-texto placeholder:text-tenue/70 focus:border-carmesi-claro focus:outline-none"
        />
        {[
          { id: 'plataforma', nombre: 'Plataforma', opciones: plataformas.map((p) => [p, p]) },
          { id: 'so', nombre: 'Sistema', opciones: sistemas.map((s) => [s, s]) },
          { id: 'dificultad', nombre: 'Dificultad', opciones: dificultades.map((d) => [d, DIFICULTADES[d].nombre]) },
        ].map((f) => (
          <>
            <label class="sr-only" for={f.id}>{f.nombre}</label>
            <select id={f.id} data-filtro={f.id} class="h-11 rounded-lg border border-linea bg-superficie px-3 text-texto focus:border-carmesi-claro focus:outline-none">
              <option value="">{f.nombre}: todas</option>
              {f.opciones.map(([valor, texto]) => <option value={valor}>{texto}</option>)}
            </select>
          </>
        ))}
      </div>
    )}

    {todos.length === 0 ? (
      <p class="mt-12 text-tenue">Todavía no hay write-ups publicados.</p>
    ) : (
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="lista">
        {todos.map((w) => {
          const d = DIFICULTADES[w.data.dificultad];
          const windows = w.data.so.toLowerCase().includes('windows');
          return (
            <li
              class="group relative flex flex-col gap-4 rounded-xl border border-linea bg-superficie p-6 hover:border-tenue/60"
              data-plataforma={w.data.plataforma}
              data-so={w.data.so}
              data-dificultad={w.data.dificultad}
              data-texto={[w.data.maquina, ...w.data.tags, extracto(w)].join(' ').toLowerCase()}
            >
              <div class="flex items-center justify-between gap-3 text-sm text-tenue">
                <span class="inline-flex items-center gap-1.5">
                  <Icono nombre={windows ? 'windows' : 'linux'} tam={15} />
                  {w.data.plataforma}, {w.data.so}
                </span>
                <span class={`rounded-md border px-2 py-0.5 font-semibold ${d.clase}`}>{d.nombre}</span>
              </div>
              <h2 class="text-2xl font-bold tracking-tight text-texto">
                <a href={urlWriteup(w)} class="after:absolute after:inset-0 group-hover:text-carmesi-claro">{w.data.maquina}</a>
              </h2>
              <p class="flex-1 text-tenue">{extracto(w, 150)}</p>
              <p class="text-sm text-tenue">
                <time datetime={w.data.fecha.toISOString()}>{fecha(w.data.fecha)}</time>{w.data.tags.length > 0 && <span>, {w.data.tags.slice(0, 3).join(', ')}</span>}
              </p>
            </li>
          );
        })}
      </ul>
    )}
    <p id="sin-resultados" class="mt-10 hidden text-tenue">Ningún write-up coincide con esos filtros.</p>
  </div>
</Base>

<script>
  const buscar = document.querySelector<HTMLInputElement>('#buscar');
  const filtros = [...document.querySelectorAll<HTMLSelectElement>('[data-filtro]')];
  const tarjetas = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
  const sinResultados = document.querySelector('#sin-resultados');

  function filtrar() {
    const texto = (buscar?.value ?? '').trim().toLowerCase();
    let visibles = 0;
    for (const t of tarjetas) {
      const ok =
        (!texto || (t.dataset.texto ?? '').includes(texto)) &&
        filtros.every((f) => !f.value || t.dataset[f.dataset.filtro!] === f.value);
      t.hidden = !ok;
      if (ok) visibles++;
    }
    sinResultados?.classList.toggle('hidden', visibles > 0);
  }

  buscar?.addEventListener('input', filtrar);
  for (const f of filtros) f.addEventListener('change', filtrar);
</script>
