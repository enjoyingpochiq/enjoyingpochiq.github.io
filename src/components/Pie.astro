---
import Icono from './Icono.astro';
import { perfil } from '../data/perfil';

const año = new Date().getFullYear();
---

<footer id="contacto" class="mt-24 border-t border-linea">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1fr_auto] md:items-end">
    <div class="max-w-xl">
      <h2 class="text-2xl font-bold tracking-tight text-texto">¿Hablamos?</h2>
      <p class="mt-3 text-tenue">
        Si quieres comentar algo de lo que publico o proponerme algo, escríbeme.
      </p>
      <a
        href={`mailto:${perfil.correo}`}
        class="mt-6 inline-flex items-center gap-2.5 rounded-lg bg-carmesi px-5 py-3 font-semibold text-white hover:bg-carmesi-oscuro"
      >
        <Icono nombre="correo" />
        {perfil.correo}
      </a>
    </div>
    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-tenue">
      <li>
        <a href={perfil.linkedin} rel="me noopener" class="inline-flex items-center gap-2 hover:text-texto">
          <Icono nombre="linkedin" /> LinkedIn
        </a>
      </li>
      <li>
        <a href={perfil.github} rel="me noopener" class="inline-flex items-center gap-2 hover:text-texto">
          <Icono nombre="github" /> GitHub
        </a>
      </li>
      <li>
        <a href="/rss.xml" class="inline-flex items-center gap-2 hover:text-texto">
          <Icono nombre="rss" /> RSS
        </a>
      </li>
    </ul>
  </div>
  <div class="mx-auto max-w-6xl px-5 pb-10 text-sm text-tenue sm:px-8">
    © {año} {perfil.nombre}
  </div>
</footer>
