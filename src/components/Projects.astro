---
// src/components/Projects.astro

const projects = [
    {
        title: "PenMap",
        description: "Herramienta de automatización de reconocimiento y mapeo de red. Orquesta escaneos de Nmap, parsea los resultados y genera un mapa visual de la superficie de ataque para priorizar vectores en auditorías internas.",
        tags: ["Python", "Nmap", "Bash", "Recon"],
        github: "https://github.com/tu-usuario/penmap",
        demo: "#", // Aquí irá el enlace a la página dedicada o video
        featured: true
    },
    {
        title: "PwnDoc Custom Templates",
        description: "Plantillas personalizadas y scripts para automatizar la generación de reportes en PwnDoc. Estandariza la estructura de los hallazgos (CVSS, remediación) reduciendo el tiempo de reporting en un 40%.",
        tags: ["JavaScript", "YAML", "Reporting"],
        github: "https://github.com/tu-usuario/pwndoc-templates",
        demo: "",
        featured: false
    },
    {
        title: "AD PrivEsc Automator",
        description: "Script ligero para enumeración rápida de vectores de escalada de privilegios locales en entornos Windows comprometidos, verificando configuraciones erróneas comunes antes de subir herramientas más pesadas.",
        tags: ["PowerShell", "Active Directory"],
        github: "https://github.com/tu-usuario/ad-privesc",
        demo: "",
        featured: false
    }
];
---

<section class="flex flex-col gap-12 pt-24">
    
    <div class="flex flex-col gap-3" data-aos="fade-right">
        <h3 class="text-3xl font-mono text-red-accent uppercase tracking-widest">03. Arsenal Propio</h3>
        <p class="text-4xl md:text-5xl font-extrabold text-white tracking-tighter leading-tight">
            No solo uso herramientas. <br/>
            <span class="text-zinc-500">Las construyo.</span>
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        {projects.map((project, index) => (
            <div class={`group relative p-8 rounded-3xl bg-bg-card border border-border-subtle overflow-hidden transition-all duration-300 hover:border-red-accent/40 hover:-translate-y-1 hover:shadow-[0_10px_40px_-10px_rgba(225,29,72,0.15)] flex flex-col gap-6 ${project.featured ? 'md:col-span-2' : ''}`}
                 data-aos="fade-up" data-aos-delay={index * 100}>
                
                <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-red-accent/10 blur-[100px] rounded-full group-hover:bg-red-accent/20 transition-all pointer-events-none z-0"></div>

                {/* Si es el proyecto destacado (PenMap), le ponemos una "terminal" decorativa */}
                {project.featured && (
                    <div class="relative z-10 w-full h-48 md:h-64 bg-zinc-950 border border-zinc-800 rounded-xl overflow-hidden mb-2 shadow-2xl flex flex-col">
                        <div class="flex items-center gap-2 px-4 py-3 bg-zinc-900 border-b border-zinc-800">
                            <div class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500/20 border border-yellow-500/50"></div>
                            <div class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"></div>
                            <span class="ml-2 text-xs font-mono text-zinc-500">kali@ey-pentest:~ /penmap</span>
                        </div>
                        <div class="p-4 font-mono text-sm text-zinc-400 flex flex-col gap-2">
                            <p><span class="text-red-accent">❯</span> ./penmap.py -t 10.10.10.0/24 --stealth</p>
                            <p class="text-zinc-500">[+] Initializing stealth recon modules...</p>
                            <p class="text-zinc-500">[+] Bypassing basic IDS signatures...</p>
                            <p class="text-white animate-pulse">Mapping attack surface. Please wait...</p>
                        </div>
                    </div>
                )}

                <div class="relative z-10 flex flex-col flex-grow gap-4">
                    <h4 class="text-2xl md:text-3xl font-bold text-white tracking-tight">{project.title}</h4>
                    <p class="text-zinc-400 leading-relaxed text-base flex-grow">
                        {project.description}
                    </p>
                    
                    <div class="flex flex-wrap gap-2 mt-2">
                        {project.tags.map((tag) => (
                            <span class="px-2.5 py-1 text-xs font-mono text-red-accent bg-red-accent/10 rounded-md">
                                {tag}
                            </span>
                        ))}
                    </div>

                    <div class="flex items-center gap-4 mt-4 pt-4 border-t border-border-subtle">
                        {project.github && (
                            <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-zinc-300 hover:text-red-accent transition-colors flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                                Código Fuente
                            </a>
                        )}
                        {project.demo && (
                            <a href={project.demo} class="text-sm font-medium text-white hover:text-red-accent transition-colors flex items-center gap-2 ml-auto">
                                Ver Detalles
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </a>
                        )}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>