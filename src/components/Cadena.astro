---
// La cadena de ataque de un write-up: de la enumeración a root o SYSTEM, paso a paso.
interface Props {
  pasos: string[];
  compacta?: boolean; // en las tarjetas: una línea de texto, sin cajas
}
const { pasos, compacta = false } = Astro.props;
const ultimo = pasos.length - 1;
---

{pasos.length > 0 && (
  compacta ? (
    <p class="text-sm leading-relaxed text-tenue">
      <span class="sr-only">Cadena de ataque: </span>
      {pasos.map((p, i) => (
        <>
          <span class={`whitespace-nowrap ${i === ultimo ? 'font-semibold text-carmesi-claro' : ''}`}>{p}</span>
          {i < ultimo && <span aria-hidden="true" class="text-tenue/60">{' › '}</span>}
        </>
      ))}
    </p>
  ) : (
    <div>
      <p class="mb-2.5 text-sm text-tenue">Cadena de ataque</p>
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-2">
        {pasos.map((p, i) => (
          <li class="flex items-center gap-1.5">
            <span
              class={`rounded-md px-2.5 py-1 text-sm ring-1 ${
                i === ultimo ? 'bg-carmesi/15 font-semibold text-carmesi-claro ring-carmesi-claro/40' : 'bg-superficie text-texto ring-linea'
              }`}
            >
              {p}
            </span>
            {i < ultimo && (
              <svg class="text-tenue/70" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </div>
  )
)}
