---
// Una publicación por fila: fecha, tipo y título con su resumen.
import { fecha, type Publicacion } from '../lib/contenido';

interface Props {
  publicaciones: Publicacion[];
  vacio?: string;
}
const { publicaciones, vacio = 'Todavía no hay nada publicado.' } = Astro.props;
---

{publicaciones.length === 0 ? (
  <p class="border-t border-linea py-6 text-tenue">{vacio}</p>
) : (
  <ol class="border-t border-linea">
    {publicaciones.map((p) => (
      <li class="group relative grid gap-x-8 gap-y-1 border-b border-linea py-5 sm:grid-cols-[8.5rem_1fr]">
        <div class="flex gap-3 text-sm text-tenue sm:flex-col sm:gap-0.5">
          <time datetime={p.fecha.toISOString()} class="tabular-nums">{fecha(p.fecha)}</time>
          <span>{p.tipo}{p.detalle && <span class="sm:block"><span class="sm:hidden">, </span>{p.detalle}</span>}</span>
        </div>
        <div>
          <h3 class="text-lg font-semibold leading-snug text-texto">
            <a href={p.url} class="after:absolute after:inset-0 group-hover:text-carmesi-claro">
              {p.titulo}
            </a>
          </h3>
          {p.resumen && <p class="mt-1 max-w-[68ch] text-tenue">{p.resumen}</p>}
        </div>
      </li>
    ))}
  </ol>
)}
