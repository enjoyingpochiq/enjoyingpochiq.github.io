---
import { perfil } from '../data/perfil';

const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/writeups/', texto: 'Write-ups' },
  { href: '/blog/', texto: 'Blog' },
  { href: '#contacto', texto: 'Contacto' },
];
const actual = (href: string) => href.startsWith('/') && ruta.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-linea bg-fondo/90 backdrop-blur supports-[backdrop-filter]:bg-fondo/75">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8" aria-label="Principal">
    <a href="/" class="whitespace-nowrap font-bold tracking-tight text-texto hover:text-white">
      {perfil.nombreCorto}
    </a>
    <ul class="flex items-center gap-0.5 text-[0.9375rem] sm:gap-2">
      {enlaces.map((e) => (
        <li>
          <a
            href={e.href}
            aria-current={actual(e.href) ? 'page' : undefined}
            class="whitespace-nowrap rounded-md px-2 py-1.5 text-tenue sm:px-2.5 hover:text-texto aria-[current=page]:text-texto aria-[current=page]:underline aria-[current=page]:decoration-carmesi aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
          >
            {e.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
