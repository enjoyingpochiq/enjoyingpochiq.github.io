---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
    image?: string;
}

// Valores por defecto para el SEO
const { 
    title,
    description = "Portfolio de Alejandro Juan Hervás Vogt. Junior Pentester y Red Teamer especializado en ataques web y Active Directory. CPTS en curso.",
    image = "/os-image.png"
} = Astro.props;

// Construimos la URL absoluta para que LinkedIn encuentre la imagen sin problemas
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://enjoyingpochiq.github.io');
const imageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
        
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Alejandro Juan Hervás Vogt" />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageURL} />
        <meta property="og:site_name" content="Portfolio de Alejandro Juan Hervás Vogt" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />
    </head>
    <body class="font-sans antialiased relative min-h-screen selection:bg-red-accent selection:text-white">
        
        <div class="fixed inset-0 -z-20 h-full w-full"
             style="background-image: linear-gradient(to right, #27272a 1px, transparent 1px), linear-gradient(to bottom, #27272a 1px, transparent 1px); background-size: 4rem 4rem; mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 80%); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 80%);">
        </div>

        <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-red-accent/15 blur-[100px] rounded-full pointer-events-none -z-10"></div>
        
        <main class="max-w-5xl mx-auto px-6 py-20 relative z-10 flex flex-col gap-24">
            <slot />
        </main>
        
        <script>
            import AOS from 'aos';
            import 'aos/dist/aos.css'; // Importa los estilos de animación
            
            // Inicializamos AOS con una configuración suave
            AOS.init({
                duration: 800, // Duración de la animación (ms)
                easing: 'ease-out-cubic', // Suavizado
                once: true, // La animación solo ocurre una vez al hacer scroll
                offset: 50, // Empieza 50px antes de que llegue al viewport
            });
        </script>
    </body>
</html>